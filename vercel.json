{
  "rewrites": [
    { "source": "/pie-chart-maker", "destination": "/pie-chart-maker/index.html" },
    { "source": "/bar-graph-maker", "destination": "/bar-graph-maker/index.html" },
    { "source": "/convert-excel-to-chart", "destination": "/convert-excel-to-chart/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
